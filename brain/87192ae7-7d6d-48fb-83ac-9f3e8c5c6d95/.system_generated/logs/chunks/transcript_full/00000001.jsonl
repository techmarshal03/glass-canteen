mically displays remaining balance and recharge prompts. Finally, it uses checkout.\n\n\n","tool_calls":[{"name":"write_to_file","args":{"CodeContent":"import React, { useState } from 'react';\nimport { ShoppingBag, Clock, CreditCard, ShieldCheck, HelpCircle, Wallet, AlertTriangle, AlertCircle } from 'lucide-react';\n\nexport default function CartCheckout({ cart, walletBalance, checkout, setStudentTab, topUpWallet }) {\n  const [isScheduled, setIsScheduled] = useState(false);\n  const [scheduledSlot, setScheduledSlot] = useState('01:15 PM (Lunch Break)');\n  const [paymentMethod, setPaymentMethod] = useState('wallet');\n  const [checkoutStep, setCheckoutStep] = useState('cart'); // 'cart' -> 'simulating' -> 'success' | 'failure'\n  const [note, setNote] = useState('');\n\n  const slots = [\n    '09:45 AM (Short Break)',\n    '11:30 AM (Mid Break)',\n    '01:15 PM (Lunch Break)',\n    '03:30 PM (Tea Break)',\n    '07:30 PM (Dinner Break)'\n  ];\n\n  const subtotal = cart.reduce((acc, curr) => acc + (curr.item.price * curr.quantity), 0);\n  const packagingFee = subtotal > 0 ? 5 : 0;\n  const gst = Math.round(subtotal * 0.05); // 5% GST\n  const total = subtotal + packagingFee + gst;\n\n  const handlePlaceOrder = () => {\n    if (cart.length === 0) return;\n\n    if (paymentMethod === 'wallet') {\n      if (walletBalance < total) {\n        setCheckoutStep('wallet_low');\n        return;\n      }\n      setCheckoutStep('simulating');\n      setTimeout(() => {\n        // Successful wallet checkout\n        const orderId = `TXN-${Math.floor(100000 + Math.random() * 900000)}`;\n        const token = Math.floor(100 + Math.random() * 899);\n        checkout({\n          id: orderId,\n          token: token,\n          items: [...cart],\n          total: total,\n          paymentMethod: 'wallet',\n          isScheduled: isScheduled,\n          scheduledTime: isScheduled ? scheduledSlot : '',\n          checkedIn: !isScheduled, // if instant, prep starts now, so checked-in is true\n          note: note,\n          status: 'received',\n          timestamp: new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' })\n        }, total); // deduct wallet balance\n        setCheckoutStep('success');\n      }, 1200);\n    } else {\n      // Simulate UPI payment\n      setCheckoutStep('simulating');\n      setTimeout(() => {\n        // High likelihood of network timeout at peak rush\n        setCheckoutStep('upi_timeout');\n      }, 2000);\n    }\n  };\n\n  const handleBypassUpiFailure = () => {\n    // Top up wallet with necessary amount and proceed via wallet\n    const deficit = total - walletBalance;\n    if (deficit > 0) {\n      topUpWallet(deficit);\n    }\n    setPaymentMethod('wallet');\n    setCheckoutStep('cart');\n  };\n\n  if (cart.length === 0 && checkoutStep === 'cart') {\n    return (\n      <div className=\"portal-pane\" style={{ textAlign: 'center', padding: '40px 20px', animation: 'slideUp 0.6s cubic-bezier(0.16, 1, 0.3, 1)' }}>\n        <div style={{\n          width: '60px', height: '60px', borderRadius: '50%',\n          backgroundColor: 'rgba(15, 23, 42, 0.03)',\n          display: 'flex', alignItems: 'center', justifyCenter: 'center',\n          margin: '0 auto 16px', color: 'var(--text-secondary)'\n        }}>\n          <ShoppingBag size={28} style={{ margin: 'auto' }} />\n        </div>\n        <h3 style={{ fontSize: '18px', fontWeight: '800' }}>Your Cart is Empty</h3>\n        <p style={{ fontSize: '13px', color: 'var(--text-secondary)', margin: '6px 0 20px' }}>\n          Explore the menu to add hot snacks and meal boxes!\n        </p>\n        <button className=\"glass-btn glass-btn-primary\" onClick={() => setStudentTab('menu')}>\n          Browse Menu\n        </button>\n      </div>\n    );\n  }\n\n  return (\n    <div className=\"portal-pane\" style={{ animation: 'slideUp 0.6s cubic-bezier(0.16, 1, 0.3, 1)' }}>\n      {checkoutStep === 'cart' && (\n        <>\n          {/* Order Summary Panel */}\n          <div className=\"glass-panel\" style={{ padding: '20px', display: 'flex', flexDirection: 'column', gap: '14px' }}>\n            <h3 style={{ fontSize: '16px', fontWeight: '800', borderBottom: '1px solid rgba(15, 23, 42, 0.05)', paddingBottom: '10px' }}>\n              Selected Items\n            </h3>\n            <div style={{ display: 'flex', flexDirection: 'column', gap: '12px', maxHeight: '180px', overflowY: 'auto' }}>\n              {cart.map((item) => (\n                <div key={item.item.id} style={{ display: 'flex', justifyContent: 'space-between', alignItems: 'center', fontSize: '14px' }}>\n                  <div style={{ display: 'flex', gap: '8px', alignItems: 'center' }}>\n                    <span style={{ fontWeight: '700', color: 'var(--text-secondary)' }}>{item.quantity}x</span>\n                    <span style={{ fontWeight: '600' }}>{item.item.name}</span>\n                  </div>\n                  <span style={{ fontWeight: '700' }}>₹{item.item.price * item.quantity}</span>\n                </div>\n              ))}\n            </div>\n\n            <textarea \n              className=\"glass-input\"\n              placeholder=\"Any instructions? (e.g. less spicy, extra spoons)\"\n              value={note}\n              onChange={(e) => setNote(e.target.value)}\n              style={{ fontSize: '13px', padding: '10px', height: '60px', resize: 'none', borderStyle: 'dashed' }}\n            />\n          </div>\n\n          {/* Timing / Scheduling Panel */}\n          <div className=\"glass-panel\" style={{ padding: '20px', display: 'flex', flexDirection: 'column', gap: '16px' }}>\n            <div style={{ display: 'flex', justifyContent: 'space-between', alignItems: 'center' }}>\n              <div style={{ display: 'flex', alignItems: 'center', gap: '8px' }}>\n                <Clock size={18} color=\"var(--accent-blue)\" />\n                <h3 style={{ fontSize: '15px', fontWeight: '800' }}>Order Timing</h3>\n              </div>\n              \n              <div style={{ display: 'flex', background: 'rgba(15,23,42,0.05)', borderRadius: '99px', padding: '3px' }}>\n                <button \n                  onClick={() => setIsScheduled(false)} \n                  className={`glass-btn ${!isScheduled ? 'glass-btn-primary' : ''}`}\n                  style={{ padding: '4px 12px', fontSize: '11px', borderRadius: '99px', border: 'none', boxShadow: !isScheduled ? '0 2px 6px rgba(0,0,0,0.15)' : 'none' }}\n                >\n                  Instant\n                </button>\n                <button \n                  onClick={() => setIsScheduled(true)} \n                  className={`glass-btn ${isScheduled ? 'glass-btn-primary' : ''}`}\n                  style={{ padding: '4px 12px', fontSize: '11px', borderRadius: '99px', border: 'none', boxShadow: isScheduled ? '0 2px 6px rgba(0,0,0,0.15)' : 'none' }}\n                >\n                  Schedule\n                </button>\n              </div>\n            </div>\n\n            {isScheduled ? (\n              <div style={{ display: 'flex', flexDirection: 'column', gap: '12px' }} style={{ animation: 'slideUp 0.3s ease-out' }}>\n                <div style={{ display: 'flex', flexDirection: 'column', gap: '6px' }}>\n                  <label style={{ fontSize: '12px', color: 'var(--text-secondary)', fontWeight: '600' }}>Select Break Time Slot</label>\n                  <select \n                    className=\"glass-input\" \n                    value={scheduledSlot}\n                    onChange={(e) => setScheduledSlot(e.target.value)}\n                    style={{ width: '100%', cursor: 'pointer', fontWeight: '600' }}\n                  >\n                    {slots.map(s => <option key={s} value={s}>{s}</option>)}\n                  </select>\n                </div>\n                <div style={{ \n                  display: 'flex', gap: '8px', \n                  backgroundColor: 'var(--accent-blue-bg)', \n                  border: '1px solid rgba(2,132,199,0.15)',\n                  padding: '10px 12px', borderRadius: 'var(--radius-sm)',\n                  fontSize: '12px', color: 'var(--text-primary)', fontWeight: '500'\n                }}>\n                  <Info size={16} color=\"var(--accent-blue)\" style={{ flexShrink: 0 }} />\n                  <span><strong>Smart Pickup:</strong> Food won't sit cold! Prep starts only when you scan the check-in QR code or tap \"Check-In\" on arrival.</span>\n                </div>\n              </div>\n            ) : (\n              <p style={{ fontSize: '13px', color: 'var(--text-secondary)', fontWeight: '500' }}>\n                Preparation starts immediately. Cook time estimate: <strong>10 mins</strong>.\n              </p>\n            )}\n          </div>\n\n          {/* Payment Method Panel */}\n          <div className=\"glass-panel\" style={{ padding: '20px', display: 'flex', flexDirection: 'column', gap: '16px' }}>\n            <div style={{ display: 'flex', alignItems: 'center', gap: '8px' }}>\n              <CreditCard size={18} />\n              <h3 style={{ fontSize: '15px', fontWeight: '800' }}>Payment Mode</h3>\n            </div>\n\n            <div style={{ display: 'flex', flexDirection: 'column', gap: '10px' }}>\n              <div \n                onClick={() => setPaymentMethod('wallet')}\n                style={{\n                  display: 'flex', justifyContent: 'space-between', alignItems: 'center',\n                  padding: '12px 14px', borderRadius: 'var(--radius-sm)',\n                  border: `2px solid ${paymentMethod === 'wallet' ? 'var(--accent-primary)' : 'rgba(15,23,42,0.06)'}`,\n                  background: paymentMethod === 'wallet' ? 'rgba(255,255,255,0.8)' : 'rgba(255,255,255,0.3)',\n                  cursor: 'pointer', transition: 'var(--transition-smooth)'\n                }}\n              >\n                <div style={{ display: 'flex', gap: '10px', alignItems: 'center' }}>\n                  <Wallet size={18} color=\"var(--text-primary)\" />\n                  <div>\n                    <span style={{ fontSize: '14px', fontWeight: '700', display: 'block' }}>Canteen Wallet</span>\n                    <span style={{ fontSize: '11px', color: 'var(--text-secondary)' }}>Balance: ₹{walletBalance.toFixed(2)}</span>\n                  </div>\n                </div>\n                <div style={{\n                  width: '18px', height: '18px', borderRadius: '50%',\n                  border: '2px solid var(--accent-primary)',\n                  display: 'flex', alignItems: 'center', justifyCenter: 'center',\n                  padding: '3px'\n                }}>\n                  {paymentMethod === 'wallet' && <div style={{ width: '100%', height: '100%', borderRadius: '50%', backgroundColor: 'var(--accent-primary)' }} />}\n                </div>\n              </div>\n\n              <div \n                onClick={() => setPaymentMethod('upi')}\n                style={{\n                  display: 'flex', justifyContent: 'space-between', alignItems: 'center',\n                  padding: '12px 14px', borderRadius: 'var(--radius-sm)',\n                  border: `2px solid ${paymentMethod === 'upi' ? 'var(--accent-primary)' : 'rgba(15,23,42,0.06)'}`,\n                  background: paymentMethod === 'upi' ? 'rgba(255,255,255,0.8)' : 'rgba(255,255,255,0.3)',\n                  cursor: 'pointer', transition: 'var(--transition-smooth)'\n                }}\n              >\n                <div style={{ display: 'flex', gap: '10px', alignItems: 'center' }}>\n                  <span style={{ fontSize: '18px', fontWeight: '900', fontStyle: 'italic', letterSpacing: '-1.5px', color: '#0284c7' }}>UPI</span>\n                  <div>\n                    <span style={{ fontSize: '14px', fontWeight: '700', display: 'block' }}>Direct UPI Gateway</span>\n                    <span style={{ fontSize: '11px', color: 'var(--accent-orange)', fontWeight: '600' }}>⚠️ Peak Hour Network Failure Risk</span>\n                  </div>\n                </div>\n                <div style={{\n                  width: '18px', height: '18px', borderRadius: '50%',\n                  border: '2px solid var(--accent-primary)',\n                  display: 'flex', alignItems: 'center', justifyCenter: 'center',\n                  padding: '3px'\n                }}>\n                  {paymentMethod === 'upi' && <div style={{ width: '100%', height: '100%', borderRadius: '50%', backgroundColor: 'var(--accent-primary)' }} />}\n                </div>\n              </div>\n            </div>\n\n            {/* Bill Summary */}\n            <div style={{ display: 'flex', flexDirection: 'column', gap: '6px', fontSize: '13px', borderTop: '1px solid rgba(15,23,42,0.05)', paddingTop: '12px' }}>\n              <div style={{ display: 'flex', justifyContent: 'space-between' }}>\n                <span style={{ color: 'var(--text-secondary)' }}>Subtotal</span>\n                <span>₹{subtotal}</span>\n              </div>\n              <div style={{ display: 'flex', justifyContent: 'space-between' }}>\n                <span style={{ color: 'var(--text-secondary)' }}>Packaging Fee</span>\n                <span>₹{packagingFee}</span>\n              </div>\n              <div style={{ display: 'flex', justifyContent: 'space-between' }}>\n                <span style={{ color: 'var(--text-secondary)' }}>CGST/SGST (5%)</span>\n                <span>₹{gst}</span>\n              </div>\n              <div style={{ display: 'flex', justifyContent: 'space-between', fontSize: '15px', fontWeight: '800', borderTop: '1px dotted rgba(15,23,42,0.1)', paddingTop: '8px', marginTop: '4px' }}>\n                <span>Grand Total</span>\n                <span>₹{total}</span>\n              </div>\n            </div>\n\n            <button \n              className=\"glass-btn glass-btn-primary\" \n              style={{ width: '100%', padding: '14px', borderRadius: 'var(--radius-sm)', fontSize: '15px' }}\n              onClick={handlePlaceOrder}\n            >\n              Pay & Place Order (₹{total})\n            </button>\n          </div>\n        </>\n      )}\n\n      {/* Simulator / Processing State */}\n      {checkoutStep === 'simulating' && (\n        <div className=\"glass-panel\" style={{ padding: '40px 20px', textAlign: 'center', display: 'flex', flexDirection: 'column', alignItems: 'center', gap: '20px' }}>\n          <div style={{\n            width: '60px', height: '60px',\n            border: '4px solid rgba(15,23,42,0.08)',\n            borderTopColor: 'var(--accent-primary)',\n            borderRadius: '50%',\n            animation: 'shimmer 1.5s infinite linear',\n            borderRadius: '50%',\n            boxSizing: 'border-box'\n          }} className=\"pulse-animation\" />\n          <div>\n            <h3 style={{ fontSize: '18px', fontWeight: '800' }}>Processing Payment...</h3>\n            <p style={{ fontSize: '13px', color: 'var(--text-secondary)', marginTop: '6px' }}>\n              {paymentMethod === 'wallet' ? 'Securing funds from wallet locally...' : 'Re-routing to UPI payment servers (Bank gateway)...'}\n            </p>\n          </div>\n        </div>\n      )}\n\n      {/* Wallet Balance Deficit Warning */}\n      {checkoutStep === 'wallet_low' && (\n        <div className=\"glass-panel\" style={{ padding: '32px 24px', textAlign: 'center', display: 'flex', flexDirection: 'column', alignItems: 'center', gap: '16px' }}>\n          <AlertCircle size={44} color=\"var(--accent-red)\" />\n          <div>\n            <h3 style={{ fontSize: '18px', fontWeight: '800' }}>Insufficient Wallet Balance</h3>\n            <p style={{ fontSize: '13px', color: 'var(--text-secondary)', marginTop: '6px' }}>\n              Your current balance is <strong>₹{walletBalance.toFixed(2)}</strong>, but the total bill is <strong>₹{total}</strong>.\n            </p>\n          </div>\n\n          <div style={{ display: 'flex', gap: '12px', width: '100%', marginTop: '8px' }}>\n            <button className=\"glass-btn\" style={{ flex: 1 }} onClick={() => setCheckoutStep('cart')}>\n              Change Payment\n            </button>\n            <button \n              className=\"glass-btn glass-btn-primary\" \n              style={{ flex: 1 }}\n              onClick={() => {\n                topUpWallet(total - walletBalance);\n                setCheckoutStep('cart');\n              }}\n            >\n              Recharge ₹{(total - walletBalance).toFixed(0)}\n            </button>\n          </div>\n        </div>\n      )}\n\n      {/* UPI Network Failure Simulator */}\n      {checkoutStep === 'upi_timeout' && (\n        <div className=\"glass-panel\" style={{ padding: '32px 24px', textAlign: 'center', display: 'flex', flexDirection: 'column', alignItems: 'center', gap: '16px', border: '1px solid rgba(239, 68, 68, 0.4)' }}>\n          <AlertTriangle size={48} color=\"var(--accent-orange)\" className=\"pulse-animation\" />\n          <div>\n            <h3 style={{ fontSize: '18px', fontWeight: '800', color: 'var(--text-primary)' }}>UPI Gateway Timed Out</h3>\n            <p style={{ fontSize: '13px', color: 'var(--text-secondary)', marginTop: '8px', lineHeight: '1.4' }}>\n              Canteen peak hour cell congestion occurred! The bank gateway timed out, causing payment failure.\n            </p>\n          </div>\n\n          <div style={{ \n            backgroundColor: 'var(--accent-green-bg)', \n            border: '1px solid rgba(16,185,129,0.15)',\n            padding: '12px', borderRadius: 'var(--radius-sm)',\n            fontSize: '12px', color: 'var(--text-primary)', width: '100%',\n            fontWeight: '600'\n          }}>\n            🎉 Bypass Trick: Recharge and pay with Canteen Wallet instantly using strong hostel WiFi or cellular network beforehand.\n          </div>\n\n          <div style={{ display: 'flex', flexDirection: 'column', gap: '10px', width: '100%' }}>\n            <button \n              className=\"glass-btn glass-btn-primary\" \n              style={{ width: '100%', background: 'var(--accent-green)', borderColor: 'var(--accent-green)' }}\n              onClick={handleBypassUpiFailure}\n            >\n              Convert to Wallet Payment & Retry\n            </button>\n            <button className=\"glass-btn glass-btn-secondary\" onClick={() => setCheckoutStep('cart')}>\n              Back to Checkout\n            </button>\n          </div>\n        </div>\n      )}\n\n      {/* Success View */}\n      {checkoutStep === 'success' && (\n        <div className=\"glass-panel\" style={{ padding: '40px 20px', textAlign: 'center', display: 'flex', flexDirection: 'column', alignItems: 'center', gap: '20px' }}>\n          <div style={{\n            width: '60px', height: '60px', borderRadius: '50%',\n            backgroundColor: 'var(--accent-green-bg)',\n            display: 'flex', alignItems: 'center', justifyCenter: 'center',\n            color: 'var(--accent-green)', margin: '0 auto'\n          }}>\n            <ShieldCheck size={36} style={{ margin: 'auto' }} />\n          </div>\n          <div>\n            <h3 style={{ fontSize: '20px', fontWeight: '800' }}>Order Placed Successfully!</h3>\n            <p style={{ fontSize: '13px', color: 'var(--text-secondary)', marginTop: '6px' }}>\n              Your token has been sent to the kitchen. Track your order in the next tab.\n            </p>\n          </div>\n          <button className=\"glass-btn glass-btn-primary\" onClick={() => setStudentTab('tracker')}>\n            Track Order\n          </button>\n        </div>\n      )}\n    </div>\n  );\n}\n","Description":"Create CartCheckout component with scheduling selector, bill details, wallet deficit recharge popups, and the educative UPI network failure bypass simulator.","Overwrite":true,"TargetFile":"C:\\Users\\Raja\\.gemini\\antigravity\\scratch\\canteen-app\\src\\components\\CartCheckout.jsx","toolAction":"Writing CartCheckout.jsx component","toolSummary":"Create CartCheckout component"}}]}
