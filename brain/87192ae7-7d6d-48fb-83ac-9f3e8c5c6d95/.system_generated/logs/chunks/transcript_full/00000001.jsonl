{"step_index":61,"source":"MODEL","type":"PLANNER_RESPONSE","status":"DONE","created_at":"2026-08-16T14:25:50Z","thinking":"**Defining Order Tracker**\n\nI'm making good progress! I've started thinking about how to implement `OrderTracker.jsx`. Right now, I'm focusing on its key component: the Active Orders List. I'm planning to display the token number for each order and the dishes with their quantities. I'm also planning to create a cooking status timeline like this: `[Placed] --- [In Kitchen] --- [Ready for Pickup]`.\n\n\n","tool_calls":[{"name":"write_to_file","args":{"CodeContent":"import React, { useState } from 'react';\nimport { Clock, CheckCircle2, ChevronRight, AlertCircle, QrCode, MapPin, ShieldAlert, Check } from 'lucide-react';\n\nexport default function OrderTracker({ activeOrders, triggerCheckIn }) {\n  const [showQrToken, setShowQrToken] = useState(null); // stores order ID to show QR for\n\n  if (activeOrders.length === 0) {\n    return (\n      <div className=\"portal-pane\" style={{ textAlign: 'center', padding: '40px 20px', animation: 'slideUp 0.6s cubic-bezier(0.16, 1, 0.3, 1)' }}>\n        <div style={{\n          width: '60px', height: '60px', borderRadius: '50%',\n          backgroundColor: 'rgba(15, 23, 42, 0.03)',\n          display: 'flex', alignItems: 'center', justifyCenter: 'center',\n          margin: '0 auto 16px', color: 'var(--text-secondary)'\n        }}>\n          <Clock size={28} style={{ margin: 'auto' }} />\n        </div>\n        <h3 style={{ fontSize: '18px', fontWeight: '800' }}>No Active Orders</h3>\n        <p style={{ fontSize: '13px', color: 'var(--text-secondary)', margin: '6px 0' }}>\n          You don't have any orders cooking or scheduled right now.\n        </p>\n      </div>\n    );\n  }\n\n  const getStatusStep = (status) => {\n    switch(status) {\n      case 'received': return 1;\n      case 'preparing': return 2;\n      case 'ready': return 3;\n      case 'collected': return 4;\n      default: return 1;\n    }\n  };\n\n  return (\n    <div className=\"portal-pane\" style={{ animation: 'slideUp 0.6s cubic-bezier(0.16, 1, 0.3, 1)', maxHeight: 'calc(100vh - 200px)', overflowY: 'auto', paddingRight: '4px' }}>\n      <h3 style={{ fontSize: '16px', fontWeight: '800', marginBottom: '4px' }}>Your Active Tokens</h3>\n      \n      <div style={{ display: 'flex', flexDirection: 'column', gap: '20px' }}>\n        {activeOrders.map((order) => {\n          const currentStep = getStatusStep(order.status);\n          \n          return (\n            <div key={order.id} className=\"glass-panel\" style={{ padding: '20px', display: 'flex', flexDirection: 'column', gap: '16px', position: 'relative' }}>\n              \n              {/* Order Card Header */}\n              <div style={{ display: 'flex', justifyContent: 'space-between', alignItems: 'flex-start' }}>\n                <div>\n                  <span style={{ fontSize: '12px', color: 'var(--text-secondary)', fontWeight: '700' }}>\n                    Token #{order.token} • {order.timestamp}\n                  </span>\n                  <h4 style={{ fontSize: '18px', fontWeight: '900', letterSpacing: '-0.3px', marginTop: '2px' }}>\n                    ₹{order.total} • {order.items.length} {order.items.length === 1 ? 'item' : 'items'}\n                  </h4>\n                </div>\n\n                <button \n                  className=\"glass-btn\" \n                  style={{ padding: '8px 12px', fontSize: '11px', display: 'flex', gap: '6px', alignItems: 'center' }}\n                  onClick={() => setShowQrToken(showQrToken === order.id ? null : order.id)}\n                >\n                  <QrCode size={14} /> Get Token\n                </button>\n              </div>\n\n              {/* Items Summary list */}\n              <div style={{ fontSize: '13px', color: 'var(--text-secondary)', background: 'rgba(15,23,42,0.02)', padding: '10px 14px', borderRadius: 'var(--radius-xs)' }}>\n                {order.items.map((i, idx) => (\n                  <span key={idx} style={{ fontWeight: '600' }}>\n                    {i.quantity}x {i.item.name}{idx < order.items.length - 1 ? ', ' : ''}\n                  </span>\n                ))}\n                {order.note && <p style={{ fontSize: '11px', fontStyle: 'italic', color: 'var(--accent-orange)', marginTop: '4px' }}>Note: {order.note}</p>}\n              </div>\n\n              {/* Scheduled Order Flow (Awaiting check-in) */}\n              {order.isScheduled && !order.checkedIn ? (\n                <div style={{ \n                  display: 'flex', flexDirection: 'column', gap: '12px',\n                  backgroundColor: 'var(--accent-orange-bg)', border: '1px solid rgba(249,115,22,0.15)',\n                  padding: '16px', borderRadius: 'var(--radius-sm)'\n                }}>\n                  <div style={{ display: 'flex', gap: '10px', alignItems: 'flex-start' }}>\n                    <MapPin size={20} color=\"var(--accent-orange)\" style={{ flexShrink: 0, marginTop: '2px' }} />\n                    <div style={{ textAlign: 'left' }}>\n                      <strong style={{ fontSize: '13px', display: 'block', color: 'var(--text-primary)' }}>Scheduled for {order.scheduledTime}</strong>\n                      <span style={{ fontSize: '12px', color: 'var(--text-secondary)', display: 'block', marginTop: '2px' }}>\n                        Preparation is locked to prevent cold food. Tap below when you arrive at the canteen so the chef starts cooking!\n                      </span>\n                    </div>\n                  </div>\n                  <button \n                    className=\"glass-btn glass-btn-primary\" \n                    style={{ width: '100%', padding: '10px', background: 'var(--accent-orange)', borderColor: 'var(--accent-orange)', fontSize: '13px' }}\n                    onClick={() => triggerCheckIn(order.id)}\n                  >\n                    📍 Check-In at Canteen (Start Cooking)\n                  </button>\n                </div>\n              ) : (\n                /* Interactive Timeline Tracker */\n                <div style={{ display: 'flex', flexDirection: 'column', gap: '12px' }}>\n                  <div style={{ display: 'flex', justifyContent: 'space-between', position: 'relative', width: '100%', padding: '0 10px' }}>\n                    \n                    {/* Connecting Bar */}\n                    <div style={{\n                      position: 'absolute',\n                      top: '12px', left: '10%', right: '10%',\n                      height: '3px',\n                      backgroundColor: 'rgba(15,23,42,0.05)',\n                      zIndex: 1\n                    }}>\n                      <div style={{\n                        height: '100%',\n                        width: `${((currentStep - 1) / 3) * 100}%`,\n                        backgroundColor: order.status === 'ready' || order.status === 'collected' ? 'var(--accent-green)' : 'var(--accent-blue)',\n                        transition: 'var(--transition-smooth)'\n                      }} />\n                    </div>\n\n                    {/* Timeline Nodes */}\n                    {[\n                      { step: 1, label: 'Placed' },\n                      { step: 2, label: 'Kitchen' },\n                      { step: 3, label: 'Ready' },\n                      { step: 4, label: 'Collected' }\n                    ].map((node) => {\n                      const isActive = currentStep >= node.step;\n                      const isCompleted = currentStep > node.step;\n                      let nodeBg = 'var(--text-white)';\n                      let nodeBorderColor = 'rgba(15,23,42,0.08)';\n                      let iconColor = 'var(--text-tertiary)';\n\n                      if (isActive) {\n                        nodeBorderColor = order.status === 'ready' || order.status === 'collected' ? 'var(--accent-green)' : 'var(--accent-blue)';\n                        nodeBg = nodeBorderColor;\n                        iconColor = 'var(--text-white)';\n                      }\n\n                      return (\n                        <div key={node.step} style={{ display: 'flex', flexDirection: 'column', alignItems: 'center', gap: '6px', zIndex: 2, position: 'relative' }}>\n                          <div style={{\n                            width: '26px', height: '26px', borderRadius: '50%',\n                            backgroundColor: nodeBg, border: `2px solid ${nodeBorderColor}`,\n                            display: 'flex', alignItems: 'center', justifyCenter: 'center',\n                            fontSize: '11px', fontWeight: '800', color: iconColor,\n                            boxShadow: isActive ? '0 4px 10px rgba(0,0,0,0.1)' : 'none',\n                            transition: 'var(--transition-smooth)'\n                          }}>\n                            <span style={{ margin: 'auto' }}>\n                              {isCompleted ? <Check size={12} strokeWidth={3} /> : node.step}\n                            </span>\n                          </div>\n                          <span style={{ \n                            fontSize: '10px', \n                            fontWeight: isActive ? '700' : '500', \n                            color: isActive ? 'var(--text-primary)' : 'var(--text-tertiary)',\n                            transition: 'var(--transition-smooth)'\n                          }}>\n                            {node.label}\n                          </span>\n                        </div>\n                      );\n                    })}\n                  </div>\n\n                  {/* Status Banner */}\n                  <div style={{ \n                    textAlign: 'center', padding: '10px', borderRadius: 'var(--radius-xs)', \n                    backgroundColor: order.status === 'ready' ? 'var(--accent-green-bg)' : 'rgba(15,23,42,0.03)',\n                    border: order.status === 'ready' ? '1px solid rgba(16,185,129,0.15)' : 'none',\n                    fontSize: '13px', fontWeight: '700', color: order.status === 'ready' ? 'var(--accent-green)' : 'var(--text-primary)',\n                    animation: order.status === 'ready' ? 'pulse-soft 2s infinite ease-in-out' : 'none'\n                  }}>\n                    {order.status === 'received' && 'Order accepted! In queue to start cooking.'}\n                    {order.status === 'preparing' && '🍳 Chef is preparing your fresh meal.'}\n                    {order.status === 'ready' && '🎉 Order ready! Head to the glass counter for collection.'}\n                    {order.status === 'collected' && '✅ Order picked up. Enjoy your meal!'}\n                  </div>\n                </div>\n              )}\n\n              {/* Dynamic QR Collection Token Slide-Down Panel */}\n              {showQrToken === order.id && (\n                <div style={{ \n                  animation: 'slideUp 0.3s ease-out', \n                  borderTop: '1px solid rgba(15,23,42,0.06)', \n                  paddingTop: '16px',\n                  display: 'flex', flexDirection: 'column', alignItems: 'center', gap: '12px'\n                }}>\n                  {/* High fidelity mockup QR code */}\n                  <div style={{\n                    width: '160px', height: '160px',\n                    background: 'rgba(255,255,255,0.85)',\n                    border: '1px solid rgba(15,23,42,0.08)',\n                    borderRadius: 'var(--radius-sm)',\n                    padding: '12px',\n                    display: 'flex', flexDirection: 'column', gap: '4px',\n                    boxShadow: '0 8px 24px rgba(0,0,0,0.04)'\n                  }}>\n                    {/* Simulated QR Code dots */}\n                    <div style={{ flex: 1, display: 'grid', gridTemplateColumns: 'repeat(10, 1fr)', gap: '2px', opacity: 0.8 }}>\n                      {Array.from({ length: 100 }).map((_, i) => {\n                        const isFilled = (i % 2 === 0 && i % 3 === 0) || (i < 20 && i % 4 === 0) || (i > 80 && i % 5 === 0) || (i > 30 && i < 50 && i % 2 !== 0);\n                        return (\n                          <div key={i} style={{ \n                            backgroundColor: isFilled ? 'var(--text-primary)' : 'transparent',\n                            borderRadius: '1px'\n                          }} />\n                        );\n                      })}\n                    </div>\n                    <span style={{ fontSize: '9px', fontWeight: '800', color: 'var(--text-tertiary)', textAlign: 'center', letterSpacing: '0.5px' }}>\n                      TOKEN-{order.token}\n                    </span>\n                  </div>\n\n                  <div style={{ \n                    backgroundColor: 'var(--accent-blue-bg)', border: '1px solid rgba(2,132,199,0.15)',\n                    borderRadius: 'var(--radius-xs)', padding: '10px 14px', fontSize: '11px', textAlign: 'left',\n                    display: 'flex', gap: '8px', color: 'var(--text-primary)', fontWeight: '600'\n                  }}>\n                    <QrCode size={16} color=\"var(--accent-blue)\" style={{ flexShrink: 0, marginTop: '2px' }} />\n                    <div>\n                      <strong>Offline Collection Shield:</strong> This token resides in your local cache. Even if you have absolutely <strong>zero cellular network</strong> inside the canteen, the bhaiya's offline scanner can verify this code.\n                    </div>\n                  </div>\n                </div>\n              )}\n\n            </div>\n          );\n        })}\n      </div>\n    </div>\n  );\n}\n","Description":"Create OrderTracker component with interactive progress timelines, timed breaks check-in alerts, and an offline-resilient collection QR scanner panel.","Overwrite":true,"TargetFile":"C:\\Users\\Raja\\.gemini\\antigravity\\scratch\\canteen-app\\src\\components\\OrderTracker.jsx","toolAction":"Writing OrderTracker.jsx component","toolSummary":"Create OrderTracker component"}}]}
