{"step_index":63,"source":"MODEL","type":"PLANNER_RESPONSE","status":"DONE","created_at":"2026-08-16T14:25:57Z","thinking":"**Designing Staff Portal**\n\nOkay, I'm diving into the implementation of `StaffPortal.jsx`, focusing on the Canteen Staff Dashboard simulator. Right now, I'm sketching out the soundbox mode settings. I'm thinking a toggle for the Paytm-style voice announcer, a neat sound waves indicator, and a custom audio chime simulator are essential. I'm getting excited to get this coded up.\n\n\n","tool_calls":[{"name":"write_to_file","args":{"CodeContent":"import React, { useState } from 'react';\nimport { ChefHat, Volume2, VolumeX, ShieldAlert, Check, ShoppingBag, ToggleLeft, ToggleRight } from 'lucide-react';\n\nexport default function StaffPortal({ orders, items, updateOrderStatus, toggleStock, soundAnnouncer, setSoundAnnouncer }) {\n  const [activeTab, setActiveTab] = useState('active'); // 'active' (received/preparing) | 'ready' | 'collected'\n\n  // Filter orders\n  const filteredOrders = orders.filter((order) => {\n    if (activeTab === 'active') return order.status === 'received' || order.status === 'preparing';\n    if (activeTab === 'ready') return order.status === 'ready';\n    if (activeTab === 'collected') return order.status === 'collected';\n    return true;\n  });\n\n  return (\n    <div className=\"portal-pane\" style={{ animation: 'slideUp 0.6s cubic-bezier(0.16, 1, 0.3, 1)', maxHeight: 'calc(100vh - 120px)', overflowY: 'auto', paddingRight: '4px' }}>\n      \n      {/* Soundbox Simulator Panel */}\n      <div className=\"glass-panel\" style={{ \n        padding: '16px 20px', \n        display: 'flex', \n        justifyContent: 'space-between', \n        alignItems: 'center',\n        background: 'linear-gradient(135deg, rgba(255,107,107,0.02) 0%, rgba(255,255,255,0.4) 100%)',\n        border: '1px solid rgba(255, 255, 255, 0.8)'\n      }}>\n        <div style={{ display: 'flex', gap: '12px', alignItems: 'center' }}>\n          <div style={{\n            width: '38px', height: '38px', borderRadius: '50%',\n            backgroundColor: soundAnnouncer ? 'var(--accent-orange-bg)' : 'rgba(15,23,42,0.05)',\n            display: 'flex', alignItems: 'center', justifyCenter: 'center',\n            color: soundAnnouncer ? 'var(--accent-orange)' : 'var(--text-secondary)',\n            transition: 'var(--transition-smooth)'\n          }}>\n            {soundAnnouncer ? <Volume2 size={20} className=\"pulse-animation\" style={{ margin: 'auto' }} /> : <VolumeX size={20} style={{ margin: 'auto' }} />}\n          </div>\n          <div>\n            <h4 style={{ fontSize: '14px', fontWeight: '800' }}>Paytm Soundbox Simulator</h4>\n            <p style={{ fontSize: '11px', color: 'var(--text-secondary)' }}>Announces order state verbally in Hindi/English</p>\n          </div>\n        </div>\n\n        <button \n          onClick={() => setSoundAnnouncer(!soundAnnouncer)}\n          className={`glass-btn ${soundAnnouncer ? 'glass-btn-primary' : ''}`}\n          style={{ \n            padding: '6px 14px', \n            fontSize: '12px', \n            background: soundAnnouncer ? 'var(--accent-orange)' : 'rgba(15,23,42,0.05)',\n            borderColor: soundAnnouncer ? 'var(--accent-orange)' : 'rgba(15,23,42,0.05)',\n            color: soundAnnouncer ? 'var(--text-white)' : 'var(--text-primary)'\n          }}\n        >\n          {soundAnnouncer ? 'Voice Enabled' : 'Voice Muted'}\n        </button>\n      </div>\n\n      {/* Orders Queue Panel */}\n      <div className=\"glass-panel\" style={{ padding: '20px', display: 'flex', flexDirection: 'column', gap: '16px' }}>\n        <div style={{ display: 'flex', justifyContent: 'space-between', alignItems: 'center' }}>\n          <div style={{ display: 'flex', alignItems: 'center', gap: '8px' }}>\n            <ChefHat size={20} />\n            <h3 style={{ fontSize: '16px', fontWeight: '800' }}>Order Fulfillment Queue</h3>\n          </div>\n\n          <div style={{ display: 'flex', background: 'rgba(15,23,42,0.05)', borderRadius: '99px', padding: '3px' }}>\n            {[\n              { id: 'active', name: 'Cooking' },\n              { id: 'ready', name: 'Ready' },\n              { id: 'collected', name: 'Collected' }\n            ].map(t => (\n              <button\n                key={t.id}\n                onClick={() => setActiveTab(t.id)}\n                style={{\n                  padding: '4px 12px', fontSize: '11px', borderRadius: '99px', border: 'none',\n                  background: activeTab === t.id ? 'var(--text-white)' : 'transparent',\n                  color: activeTab === t.id ? 'var(--text-primary)' : 'var(--text-secondary)',\n                  fontWeight: '700', cursor: 'pointer', transition: 'var(--transition-smooth)',\n                  boxShadow: activeTab === t.id ? '0 2px 6px rgba(0,0,0,0.08)' : 'none'\n                }}\n              >\n                {t.name}\n              </button>\n            ))}\n          </div>\n        </div>\n\n        {/* Orders Queue List */}\n        <div style={{ display: 'flex', flexDirection: 'column', gap: '14px', maxHeight: '320px', overflowY: 'auto', paddingRight: '2px' }}>\n          {filteredOrders.length > 0 ? (\n            filteredOrders.map((order) => (\n              <div \n                key={order.id} \n                className=\"glass-card\" \n                style={{ \n                  padding: '16px', \n                  background: 'rgba(255,255,255,0.7)', \n                  borderLeft: `4px solid ${\n                    order.status === 'received' ? 'var(--accent-orange)' : \n                    order.status === 'preparing' ? 'var(--accent-blue)' : \n                    order.status === 'ready' ? 'var(--accent-green)' : 'var(--text-tertiary)'\n                  }`,\n                  cursor: 'default'\n                }}\n              >\n                <div style={{ display: 'flex', justifyContent: 'space-between', alignItems: 'center' }}>\n                  <div>\n                    <span style={{ fontSize: '12px', fontWeight: '700', color: 'var(--text-secondary)' }}>\n                      Token #{order.token} • {order.isScheduled ? `Scheduled for ${order.scheduledTime}` : 'Instant'}\n                    </span>\n                    {order.isScheduled && !order.checkedIn && (\n                      <span style={{ display: 'block', fontSize: '11px', color: 'var(--accent-orange)', fontWeight: '700', marginTop: '2px' }}>\n                        ⚠️ Awaiting Student Check-In (Locked)\n                      </span>\n                    )}\n                  </div>\n\n                  <span style={{ fontSize: '12px', fontWeight: '800', background: 'rgba(15,23,42,0.04)', padding: '3px 8px', borderRadius: '4px' }}>\n                    {order.paymentMethod === 'wallet' ? '💼 Wallet' : '📱 UPI'}\n                  </span>\n                </div>\n\n                <div style={{ margin: '10px 0', fontSize: '13px', fontWeight: '600' }}>\n                  {order.items.map((i, idx) => (\n                    <div key={idx} style={{ display: 'flex', justifyContent: 'space-between', padding: '2px 0' }}>\n                      <span>{i.quantity}x {i.item.name}</span>\n                      <span style={{ color: 'var(--text-secondary)' }}>₹{i.item.price * i.quantity}</span>\n                    </div>\n                  ))}\n                  {order.note && <p style={{ fontSize: '11px', color: 'var(--accent-orange)', marginTop: '6px', borderTop: '1px dashed rgba(0,0,0,0.05)', paddingTop: '4px' }}>Note: \"{order.note}\"</p>}\n                </div>\n\n                {/* Queue Actions */}\n                <div style={{ display: 'flex', gap: '10px', marginTop: '8px' }}>\n                  {order.status === 'received' && (\n                    <button \n                      className={`glass-btn glass-btn-primary ${order.isScheduled && !order.checkedIn ? 'glass-btn-disabled' : ''}`}\n                      style={{ flex: 1, padding: '8px', fontSize: '12px', background: 'var(--accent-orange)', borderColor: 'var(--accent-orange)' }}\n                      onClick={() => updateOrderStatus(order.id, 'preparing')}\n                      disabled={order.isScheduled && !order.checkedIn}\n                    >\n                      🍳 Start Preparing\n                    </button>\n                  )}\n                  {order.status === 'preparing' && (\n                    <button \n                      className=\"glass-btn glass-btn-primary\" \n                      style={{ flex: 1, padding: '8px', fontSize: '12px', background: 'var(--accent-green)', borderColor: 'var(--accent-green)' }}\n                      onClick={() => updateOrderStatus(order.id, 'ready')}\n                    >\n                      🛎️ Announce Ready\n                    </button>\n                  )}\n                  {order.status === 'ready' && (\n                    <button \n                      className=\"glass-btn glass-btn-primary\" \n                      style={{ flex: 1, padding: '8px', fontSize: '12px' }}\n                      onClick={() => updateOrderStatus(order.id, 'collected')}\n                    >\n                      ✅ Collected & Close\n                    </button>\n                  )}\n                </div>\n              </div>\n            ))\n          ) : (\n            <div style={{ textAlign: 'center', padding: '30px 10px', color: 'var(--text-secondary)' }}>\n              <p style={{ fontWeight: '600', fontSize: '13px' }}>No orders in this section.</p>\n            </div>\n          )}\n        </div>\n      </div>\n\n      {/* Menu Stock Manager Panel */}\n      <div className=\"glass-panel\" style={{ padding: '20px', display: 'flex', flexDirection: 'column', gap: '14px' }}>\n        <h3 style={{ fontSize: '16px', fontWeight: '800' }}>Canteen Inventory / Stock Controls</h3>\n        \n        <div style={{ display: 'flex', flexDirection: 'column', gap: '10px', maxHeight: '220px', overflowY: 'auto' }}>\n          {items.map((item) => (\n            <div key={item.id} style={{ display: 'flex', justifyContent: 'space-between', alignItems: 'center', padding: '6px 0', borderBottom: '1px solid rgba(0,0,0,0.03)' }}>\n              <div style={{ textAlign: 'left' }}>\n                <span style={{ fontSize: '14px', fontWeight: '700', color: 'var(--text-primary)' }}>{item.name}</span>\n                <span style={{ display: 'block', fontSize: '11px', color: 'var(--text-secondary)' }}>₹{item.price} • {item.category}</span>\n              </div>\n\n              <div style={{ display: 'flex', alignItems: 'center', gap: '8px' }}>\n                <span style={{ fontSize: '11px', fontWeight: '700', color: item.inStock ? 'var(--accent-green)' : 'var(--accent-red)' }}>\n                  {item.inStock ? 'In Stock' : 'Out of Stock'}\n                </span>\n                <button\n                  onClick={() => toggleStock(item.id)}\n                  style={{ background: 'none', border: 'none', cursor: 'pointer', display: 'flex', padding: 0 }}\n                >\n                  {item.inStock ? (\n                    <ToggleRight size={38} color=\"var(--accent-green)\" style={{ opacity: 0.9 }} />\n                  ) : (\n                    <ToggleLeft size={38} color=\"var(--text-tertiary)\" style={{ opacity: 0.7 }} />\n                  )}\n                </button>\n              </div>\n            </div>\n          ))}\n        </div>\n      </div>\n\n    </div>\n  );\n}\n","Description":"Create StaffPortal component containing Paytm voice soundbox triggers, status updates, and real-time inventory toggle switches.","Overwrite":true,"TargetFile":"C:\\Users\\Raja\\.gemini\\antigravity\\scratch\\canteen-app\\src\\components\\StaffPortal.jsx","toolAction":"Writing StaffPortal.jsx component","toolSummary":"Create StaffPortal component"}}]}
